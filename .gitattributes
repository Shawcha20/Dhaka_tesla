# Normalise line endings: the repo stores LF, Windows checkouts get native.
# This matters because CRLF in a shell script breaks it inside a Linux container.
* text=auto eol=lf

# Always LF, no exceptions — these run inside Docker.
*.sh                text eol=lf
Dockerfile          text eol=lf
*.Dockerfile        text eol=lf
docker-compose*.yml text eol=lf
*.sql               text eol=lf

# Windows-only scripts keep CRLF.
*.bat               text eol=crlf
*.cmd               text eol=crlf
*.ps1               text eol=crlf

# Binary — never diff or convert.
*.png               binary
*.jpg               binary
*.jpeg              binary
*.gif               binary
*.webp              binary
*.ico               binary
*.pdf               binary
*.mp4               binary
*.woff              binary
*.woff2             binary
