# ─────────────────────────────────────────────────────────────────────────────
# Dhaka Tesla Pool — environment template
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored and must NEVER be committed.
#
# Generate each secret with:              openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ─── MySQL container (consumed by docker-compose) ────────────────────────────
MYSQL_ROOT_PASSWORD=replace_me_root_password
MYSQL_DATABASE=dhaka_tesla_pool
MYSQL_USER=tesla
MYSQL_PASSWORD=replace_me_user_password
# Host port mapped to the container's 3306. Change if 3306 is already in use.
MYSQL_HOST_PORT=3306

# ─── Database connection ─────────────────────────────────────────────────────
# Inside docker-compose the host is the service name `mysql`.
# Running the API on the host instead? Use 127.0.0.1:${MYSQL_HOST_PORT}.
DATABASE_URL="mysql://tesla:replace_me_user_password@mysql:3306/dhaka_tesla_pool"

# Separate database for the test suite, so tests never truncate dev data.
TEST_DATABASE_URL="mysql://tesla:replace_me_user_password@mysql:3306/dhaka_tesla_pool_test"

# ─── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=debug

# Comma-separated allowlist for CORS. Credentials are sent, so no wildcards.
CORS_ORIGIN=http://localhost:3000

# ─── Auth ────────────────────────────────────────────────────────────────────
# Two distinct secrets, and the API refuses to start if they match.
#   ACCESS  signs the short-lived access JWT.
#   REFRESH keys the HMAC that refresh tokens are stored under, so a stolen
#           database is not by itself enough to validate a captured token.
# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_me_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_me_with_a_different_openssl_rand_hex_32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ─── Cookies ─────────────────────────────────────────────────────────────────
# Auth cookies are always httpOnly. Secure is switched on automatically when
# NODE_ENV=production.
#
# SameSite is resolved automatically and rarely needs setting by hand:
#   development -> lax   (frontend and API are both localhost)
#   production  -> none  (Vercel and Render are different sites, so the browser
#                         only attaches cookies cross-site with None + Secure)
# Setting it to `none` outside production is rejected: None requires Secure,
# which requires HTTPS.
# COOKIE_SAMESITE=lax
#
# Only needed if the API and frontend share a parent domain and you want the
# cookie scoped to it, e.g. .dhakatesla.app
# COOKIE_DOMAIN=

# ─── Fare model ──────────────────────────────────────────────────────────────
# All money is integer paisa. 100 paisa = 1 BDT. See docs/decisions.md.
FARE_BASE_PAISA=2000
FARE_PER_KM_PAISA=1500
FARE_POOL_DISCOUNT_PCT=20

# ─── Pooling rules ───────────────────────────────────────────────────────────
# Max angle (degrees) between two passengers' pickup→dropoff bearings for their
# routes to count as compatible. See docs/decisions.md for the matching rule.
POOL_MAX_BEARING_DIFF_DEG=45

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
